PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SUPPORT_EMAIL=support@example.com
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPPORT_EMAIL=support@example.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trustshield-ai
JWT_SECRET=change-me
AI_PROVIDER=GEMINI
GEMINI_API_KEY=your-gemini-key
RESEND_API_KEY=your-resend-key
EMAIL_FROM=TrustShield AI <hello@example.com>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
WEATHER_API_KEY=optional-openweather-key
AQI_API_KEY=optional-aqi-key
OPENWEATHER_API_KEY=your-openweather-key
IPGEOLOCATION_API_KEY=your-ipgeolocation-key
PAYMENT_GATEWAY=RAZORPAY_TEST
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Replace JWT_SECRET with a long random value in production.
# Keep real secrets only in .env, never commit them.
